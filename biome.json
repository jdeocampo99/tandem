{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!node_modules",
      "!dist",
      "!evals/results",
      "!evals/results-research-continuation",
      "!.claude",
      "!src/harness/claude-code/plugins/*/.claude-plugin/types"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@oh-my-pi/**"],
                "message": "Only src/harness/omp/ and its tests may import OMP. Go through the launch port in src/harness/contract.ts."
              },
              {
                "group": ["**/terminal-backend/herdr/**"],
                "message": "Only the terminal-backend Herdr implementation may import Herdr modules. Use the backend-neutral terminal port."
              },
              {
                "group": ["**/terminal-backend/tern/**"],
                "message": "Only the terminal-backend Tern implementation and its tests may import Tern modules. Use the backend-neutral terminal port."
              },
              {
                "group": ["**/harness/omp/launch.ts", "**/harness/claude-code/launch.ts"],
                "message": "Resolve a harness with harnessFor in src/harness/resolve.ts instead of importing it."
              }
            ]
          }
        },
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noProcessEnv": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error"
      },
      "suspicious": {
        "noDeprecatedImports": "error",
        "noTsIgnore": "error",
        "noImportCycles": "error",
        "noEmptyBlockStatements": "error",
        "noConsole": "error",
        "noFocusedTests": "off",
        "noUnusedExpressions": "error",
        "noEvolvingTypes": "error"
      },
      "nursery": {
        "useExhaustiveSwitchCases": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/harness/omp/**", "tests/harness/omp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/terminal-backend/herdr/**", "**/terminal-backend/tern/**"],
                    "message": "Use the harness and terminal ports; backend imports stay in their implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/terminal-backend/herdr/**", "tests/terminal-backend/herdr/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**", "**/terminal-backend/tern/**"],
                    "message": "Use the harness and terminal ports; backend imports stay in their implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/terminal-backend/tern/**",
        "tests/terminal-backend/tern/**",
        "tests/native/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**", "**/terminal-backend/herdr/**"],
                    "message": "Use the harness and terminal ports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/terminal-backend/tern/**", "!src/terminal-backend/tern/cli.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "../../contracts.ts": {
                    "importNames": ["CommandRunner"],
                    "message": "Only src/terminal-backend/tern/cli.ts runs commands. Spawn Tern through ternCli and mutate."
                  },
                  "../../adapters/commands.ts": {
                    "importNames": ["runCommand"],
                    "message": "Only src/terminal-backend/tern/cli.ts runs commands. Spawn Tern through ternCli and mutate."
                  },
                  "node:child_process": "Only src/terminal-backend/tern/cli.ts runs commands. Spawn Tern through ternCli and mutate."
                },
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**", "**/terminal-backend/herdr/**"],
                    "message": "Use the harness and terminal ports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/terminal-backend/tern/**",
        "!src/terminal-backend/tern/cli.ts",
        "!src/terminal-backend/tern/process-reader.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Only src/terminal-backend/tern/cli.ts spawns processes (process-reader.ts runs ps for it). Spawn Tern through ternCli and mutate."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/harness/resolve.ts",
        "tests/harness/resolve.test.ts",
        "tests/harness/claude-code/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**"],
                    "message": "Only src/harness/omp/ and its tests may import OMP. Go through the launch port in src/harness/contract.ts."
                  },
                  {
                    "group": ["**/terminal-backend/herdr/**", "**/terminal-backend/tern/**"],
                    "message": "Use the terminal port."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/terminal-backend/compose.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**"],
                    "message": "Use the harness port."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error",
            "noEmptyBlockStatements": "off",
            "noConsole": "off",
            "noEvolvingTypes": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["evals/**", ".claude/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["src/harness/claude-code/sidecar.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/config/**",
        "src/main.ts",
        "src/cli.ts",
        "src/worker.ts",
        "src/validation-worker.ts",
        "src/harness/claude-code/sidecar.ts",
        "src/harness/omp/extension.ts",
        "src/harness/omp/terminal-extension.ts",
        "src/harness/omp/worker-control.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/adapters/commands.ts",
        "src/harness/claude-code/launch.ts",
        "src/harness/omp/host.ts",
        "src/service/controller.ts",
        "src/tasks/store-lock.ts",
        "src/terminal-backend/setup.ts",
        "src/terminal-backend/herdr/setup.ts",
        "src/terminal-backend/herdr/status.ts",
        "src/terminal-backend/tern/cli.ts",
        "src/terminal-backend/tern/plugin.ts",
        "src/terminal/cli-application.ts",
        "src/terminal/cli-process.ts",
        "src/terminal/environment.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
