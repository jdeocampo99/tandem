{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!node_modules",
      "!dist",
      "!evals/results",
      "!evals/results-research-continuation",
      "!.claude",
      "!src/harness/claude-code/plugins/*/.claude-plugin/types"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@oh-my-pi/**"],
                "message": "Only src/harness/omp/ and its tests may import OMP. Go through the launch port in src/harness/contract.ts."
              },
              {
                "group": ["**/terminal-backend/herdr/**"],
                "message": "Only the terminal-backend Herdr implementation may import Herdr modules. Use the backend-neutral terminal port."
              },
              {
                "group": ["**/terminal-backend/tern/**"],
                "message": "Only the terminal-backend Tern implementation and its tests may import Tern modules. Use the backend-neutral terminal port."
              },
              {
                "group": ["**/harness/omp/launch.ts", "**/harness/claude-code/launch.ts"],
                "message": "Resolve a harness with harnessFor in src/harness/resolve.ts instead of importing it."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/harness/omp/**", "tests/harness/omp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/terminal-backend/herdr/**", "**/terminal-backend/tern/**"],
                    "message": "Use the harness and terminal ports; backend imports stay in their implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/terminal-backend/herdr/**", "tests/terminal-backend/herdr/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**", "**/terminal-backend/tern/**"],
                    "message": "Use the harness and terminal ports; backend imports stay in their implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/terminal-backend/tern/**",
        "tests/terminal-backend/tern/**",
        "tests/native/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**", "**/terminal-backend/herdr/**"],
                    "message": "Use the harness and terminal ports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/harness/resolve.ts",
        "tests/harness/resolve.test.ts",
        "tests/harness/claude-code/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**"],
                    "message": "Only src/harness/omp/ and its tests may import OMP. Go through the launch port in src/harness/contract.ts."
                  },
                  {
                    "group": ["**/terminal-backend/herdr/**", "**/terminal-backend/tern/**"],
                    "message": "Use the terminal port."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/terminal-backend/compose.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@oh-my-pi/**"],
                    "message": "Use the harness port."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
