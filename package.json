{
  "name": "tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tandem": "./src/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check && bun scripts/lint-ratchet.ts",
    "lint:ratchet": "bun scripts/lint-ratchet.ts",
    "format": "biome format --write",
    "start": "bun src/cli.ts",
    "report:dead": "knip --no-exit-code",
    "report:dupes": "jscpd"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@oh-my-pi/pi-coding-agent": "18.1.18",
    "@types/bun": "^1.2.21",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@inquirer/search": "^4.3.3",
    "@inquirer/select": "^5.2.5",
    "shiki": "^4.5.0",
    "zod": "^3.25.76"
  }
}
